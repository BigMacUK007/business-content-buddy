<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Weekly Content Planner</h1>
    <p class="mt-2 text-sm text-gray-600">
      Week of <%= @current_week_start.strftime('%B %d, %Y') %>
      <% if @weekly_streak > 0 %>
        <span class="ml-4 inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium bg-green-100 text-green-800">
          🔥 <%= @weekly_streak %> week streak
        </span>
      <% end %>
    </p>
  </div>

  <!-- Weekly Board -->
  <div class="grid grid-cols-1 md:grid-cols-7 gap-4 mb-8">
    <% Post::DAYS_OF_WEEK.each do |day| %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
        <!-- Day Header -->
        <div class="mb-3">
          <h3 class="font-semibold text-gray-900 capitalize"><%= day %></h3>
          <p class="text-xs text-gray-500"><%= Post::POST_TYPES[day] %></p>
        </div>

        <!-- Posts for this day -->
        <div class="space-y-2">
          <% @posts_by_day[day].each do |post| %>
            <div class="p-3 rounded border <%= post.status == 'shipped' ? 'bg-green-50 border-green-200' : 'bg-gray-50 border-gray-200' %>">
              <div class="flex justify-between items-start mb-2">
                <h4 class="text-sm font-medium text-gray-900 line-clamp-2"><%= post.title %></h4>
                <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= post.status == 'shipped' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= post.status %>
                </span>
              </div>
              <div class="flex gap-1 mt-2">
                <%= link_to 'Edit', edit_post_path(post), class: 'text-xs text-blue-600 hover:text-blue-800' %>
                <% if post.status != 'shipped' %>
                  <%= button_to 'Ship', ship_post_path(post), method: :patch, class: 'text-xs text-green-600 hover:text-green-800', form: { data: { turbo: true } } %>
                <% else %>
                  <%= button_to 'Unship', unship_post_path(post), method: :patch, class: 'text-xs text-gray-600 hover:text-gray-800', form: { data: { turbo: true } } %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Add Post Button -->
        <%= link_to new_post_path(day_of_week: day), class: 'mt-3 block w-full text-center py-2 px-3 border border-dashed border-gray-300 rounded-md text-sm text-gray-600 hover:border-gray-400 hover:text-gray-800' do %>
          + Add Post
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Quick Access Panels -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Recent Journal Entries -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Recent Journal Entries</h2>
        <%= link_to 'View All', journal_entries_path, class: 'text-sm text-blue-600 hover:text-blue-800' %>
      </div>
      <% if @recent_journal_entries.any? %>
        <div class="space-y-3">
          <% @recent_journal_entries.each do |entry| %>
            <div class="p-3 bg-gray-50 rounded border border-gray-200">
              <p class="text-sm text-gray-700 line-clamp-2"><%= entry.content %></p>
              <p class="text-xs text-gray-500 mt-1"><%= time_ago_in_words(entry.created_at) %> ago</p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No journal entries yet. Start capturing your ideas!</p>
      <% end %>
      <%= link_to 'Add Entry', new_journal_entry_path, class: 'mt-4 block w-full text-center py-2 px-4 bg-blue-600 text-white rounded-md hover:bg-blue-700' %>
    </div>

    <!-- Proof Bank -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Proof Bank</h2>
        <%= link_to 'View All', proof_items_path, class: 'text-sm text-blue-600 hover:text-blue-800' %>
      </div>
      <% if @recent_proof_items.any? %>
        <div class="space-y-3">
          <% @recent_proof_items.each do |proof| %>
            <div class="p-3 bg-gray-50 rounded border border-gray-200">
              <h4 class="text-sm font-medium text-gray-900"><%= proof.title %></h4>
              <p class="text-xs text-gray-500 mt-1"><%= proof.proof_type.capitalize %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No proof items yet. Start collecting your wins!</p>
      <% end %>
      <%= link_to 'Add Proof', new_proof_item_path, class: 'mt-4 block w-full text-center py-2 px-4 bg-blue-600 text-white rounded-md hover:bg-blue-700' %>
    </div>
  </div>
</div>
